-- Advanced Coin Collection Script
-- Fully featured: coin spawning, bonus coins, player stats, achievements, notifications, leaderboard, respawn logic

-- Services
local Players = game:GetService("Players")         -- Player management: join/leave events, access to player objects
local Workspace = game:GetService("Workspace")     -- World context: spawning coins, positioning, physics interaction
local Debris = game:GetService("Debris")           -- Automatic timed cleanup of coins/notifications
local ReplicatedStorage = game:GetService("ReplicatedStorage") -- Template storage (optional for future expansion)

-- Templates and constants
local COIN_TEMPLATE = script.CoinTemplate          -- Standard coin template
local BONUS_COIN_TEMPLATE = script.BonusCoinTemplate -- Bonus coin template
local COIN_SPAWN_INTERVAL = 5                      -- Regular coin spawn frequency
local BONUS_COIN_SPAWN_INTERVAL = 20               -- Bonus coin spawn frequency
local COIN_LIFETIME = 20                           -- How long a regular coin exists
local BONUS_COIN_LIFETIME = 10                     -- How long a bonus coin exists
local SPAWN_AREA = Workspace.SpawnArea             -- Defines spatial bounds for coin placement

local LEADERBOARD_UPDATE_INTERVAL = 30             -- Interval for refreshing leaderboard UI
local LEADERBOARD_SIZE = 10                        -- Number of players shown on leaderboard
local NOTIFICATION_DURATION = 5                    -- On-screen notification duration in seconds

-- Achievements mapping: name => coin threshold
local Achievements = {
	["First Coin"] = 1,
	["Coin Collector"] = 50,
	["Coin Master"] = 100
}

-------------------------------------------------------------
-- Coin creation and placement logic
-------------------------------------------------------------
local function createCoin(isBonus)
	-- Determine which template to clone based on bonus flag
	local coin = isBonus and BONUS_COIN_TEMPLATE:Clone() or COIN_TEMPLATE:Clone()
	coin.Parent = Workspace  -- Add to world immediately to enable physics/touch events

	-- Random X/Z within spawn area bounds
	local x = math.random(SPAWN_AREA.Position.X - SPAWN_AREA.Size.X/2, SPAWN_AREA.Position.X + SPAWN_AREA.Size.X/2)
	local z = math.random(SPAWN_AREA.Position.Z - SPAWN_AREA.Size.Z/2, SPAWN_AREA.Position.Z + SPAWN_AREA.Size.Z/2)
	local y = SPAWN_AREA.Position.Y                         -- Maintain fixed Y for ground placement
	coin.Position = Vector3.new(x, y, z)                    -- Apply randomized spawn location

	-- Add to Debris service for automatic cleanup based on type
	Debris:AddItem(coin, isBonus and BONUS_COIN_LIFETIME or COIN_LIFETIME)
end

-------------------------------------------------------------
-- Coin collection handling
-------------------------------------------------------------
local function onCoinTouched(coin, player)
	local character = player.Character
	if not character then return end  -- Early exit if character doesn't exist

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end  -- Require humanoid for player to count as valid collector

	-- Determine coin value dynamically
	local coinValue = coin:IsA("BonusCoin") and 5 or 1
	coin:Destroy()                             -- Remove coin immediately to prevent multiple triggers
	player.leaderstats.Coins.Value += coinValue -- Increment player coin count atomically

	-- Iterate achievements, unlock any thresholds surpassed
	for achievementName, threshold in pairs(Achievements) do
		if player.leaderstats.Coins.Value >= threshold and not player:FindFirstChild(achievementName) then
			-- Create achievement marker to prevent double-triggering
			local achievementFlag = Instance.new("BoolValue")
			achievementFlag.Name = achievementName
			achievementFlag.Parent = player

			-- Trigger on-screen notification for achievement
			local notification = Instance.new("TextLabel")
			notification.Size = UDim2.new(0.3, 0, 0.1, 0)
			notification.Position = UDim2.new(0.35, 0, 0.9, 0)
			notification.Text = "Achievement Unlocked: " .. achievementName
			notification.Parent = player:WaitForChild("PlayerGui")
			Debris:AddItem(notification, NOTIFICATION_DURATION)  -- Auto-remove notification after duration
		end
	end
end

-------------------------------------------------------------
-- Initialize leaderstats for player
-------------------------------------------------------------
local function setupLeaderstats(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	-- Coins counter initialization
	local coins = Instance.new("IntValue")
	coins.Name = "Coins"
	coins.Value = 0
	coins.Parent = leaderstats
end

-------------------------------------------------------------
-- Coin spawn loops
-------------------------------------------------------------
local function startCoinSpawning()
	while true do
		createCoin(false)           -- Spawn normal coin
		wait(COIN_SPAWN_INTERVAL)   -- Maintain consistent interval
	end
end

local function startBonusCoinSpawning()
	while true do
		wait(BONUS_COIN_SPAWN_INTERVAL)  -- Initial wait before spawn
		createCoin(true)                  -- Spawn bonus coin
	end
end

-------------------------------------------------------------
-- Player join handling
-------------------------------------------------------------
local function onPlayerJoin(player)
	setupLeaderstats(player)  -- Ensure leaderstats initialized immediately

	-- CharacterAdded: bind leg touches for coin collection
	player.CharacterAdded:Connect(function(character)
		local function connectLeg(leg)
			leg.Touched:Connect(function(hit)
				-- Only respond to valid coin templates
				if hit:IsA("MeshPart") then
					if hit.Name == "CoinTemplate" or hit.Name == "BonusCoinTemplate" then
						onCoinTouched(hit, player)
					end
				end
			end)
		end

		-- Bind to left and right lower leg
		if character:FindFirstChild("LeftLowerLeg") then connectLeg(character.LeftLowerLeg) end
		if character:FindFirstChild("RightLowerLeg") then connectLeg(character.RightLowerLeg) end
	end)
end

-- Connect to PlayerAdded and handle existing players
Players.PlayerAdded:Connect(onPlayerJoin)
for _, player in ipairs(Players:GetPlayers()) do onPlayerJoin(player) end

-- Start spawn loops asynchronously
coroutine.wrap(startCoinSpawning)()
coroutine.wrap(startBonusCoinSpawning)()

-------------------------------------------------------------
-- Respawn handling
-------------------------------------------------------------
local function onPlayerRespawn(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.Died:Connect(function()
				wait(5)                   -- Respawn delay
				character:LoadCharacter() -- Force respawn
			end)
		end
	end)
end
Players.PlayerAdded:Connect(onPlayerRespawn)

-------------------------------------------------------------
-- Leaderboard logic
-------------------------------------------------------------
-- Create the leaderboard UI
local function createLeaderboard()
	-- ScreenGui container for the leaderboard, attached to the player's PlayerGui
	local gui = Instance.new("ScreenGui")
	gui.Name = "Leaderboard"                                 -- Identifier for later reference
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") -- Ensure PlayerGui exists before parenting

	-- Frame to hold the leaderboard entries
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0.3, 0, 0.5, 0)                   -- Width 30%, height 50% of screen
	frame.Position = UDim2.new(0.7, 0, 0.2, 0)               -- Place top-right-ish
	frame.Parent = gui                                        -- Add frame to the GUI container

	-- Title label
	local title = Instance.new("TextLabel")
	title.Text = "Top Players"                                -- Static title
	title.Size = UDim2.new(1, 0, 0.1, 0)                     -- Full width, 10% height of frame
	title.Position = UDim2.new(0, 0, 0, 0)                   -- Top of the frame
	title.TextScaled = true                                   -- Auto-scale text to fit
	title.Parent = frame                                      

	-- Pre-create entries for top players
	for i = 1, LEADERBOARD_SIZE do
		local entry = Instance.new("TextLabel")
		entry.Name = "Player" .. i                             -- Name each entry for easy access during updates
		entry.Size = UDim2.new(1, 0, 0.1, 0)                  -- Each entry takes 10% of the frame height
		entry.Position = UDim2.new(0, 0, i * 0.1, 0)          -- Stack entries vertically
		entry.Text = ""                                        -- Initialize with empty text
		entry.TextScaled = true                                 
		entry.Parent = frame                                   -- Parent to frame
	end
end

-- Update leaderboard dynamically
local function updateLeaderboard()
	local sortedPlayers = {}

	-- Collect all players and their coin counts
	for _, player in pairs(Players:GetPlayers()) do
		table.insert(sortedPlayers, {Name = player.Name, Coins = player.leaderstats.Coins.Value})
	end

	-- Sort players descending by coin count
	table.sort(sortedPlayers, function(a,b)
		return a.Coins > b.Coins
	end)

	-- Fetch the GUI and frame references
	local gui = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("Leaderboard")
	local frame = gui:WaitForChild("Frame")

	-- Update each pre-created entry with the correct player data
	for i = 1, LEADERBOARD_SIZE do
		local entry = frame:FindFirstChild("Player" .. i)
		if sortedPlayers[i] then
			entry.Text = sortedPlayers[i].Name .. ": " .. sortedPlayers[i].Coins .. " Coins"
		else
			entry.Text = ""  -- Clear any leftover entries if there are fewer than LEADERBOARD_SIZE players
		end
	end
end

-- Initialize leaderboard and run update loop
coroutine.wrap(function()
	createLeaderboard()                                     -- Build static UI
	while true do
		wait(LEADERBOARD_UPDATE_INTERVAL)                   -- Wait between updates
		updateLeaderboard()                                 -- Refresh entries based on current coin counts
	end
end)()

-------------------------------------------------------------
-- Notification system
-------------------------------------------------------------

-- Sends a floating text notification to a player
local function sendNotification(player, message)
	-- Create a TextLabel to display the message
	local notification = Instance.new("TextLabel")
	notification.Size = UDim2.new(0.3, 0, 0.1, 0)          -- 30% width, 10% height relative to screen
	notification.Position = UDim2.new(0.35, 0, 0.8, 0)     -- Center horizontally, near bottom of screen
	notification.Text = message                              -- Assign dynamic message content
	notification.TextScaled = true                           -- Auto-scale text to fit label
	notification.BackgroundTransparency = 0.5               -- Slight transparency to avoid blocking view
	notification.TextColor3 = Color3.fromRGB(255, 255, 255) -- White text for visibility
	notification.Parent = player:WaitForChild("PlayerGui")   -- Parent to PlayerGui so it's visible to player

	-- Schedule automatic removal after NOTIFICATION_DURATION seconds
	Debris:AddItem(notification, NOTIFICATION_DURATION)      
end

-- Check for milestone achievements (example: 50 coins)
local function checkForMilestones(player)
	-- Only trigger once per milestone using a BoolValue as a flag
	if player.leaderstats.Coins.Value >= 50 and not player:FindFirstChild("Reached50Coins") then
		-- Create BoolValue to prevent re-trigger
		local milestone = Instance.new("BoolValue")
		milestone.Name = "Reached50Coins"
		milestone.Parent = player

		-- Trigger on-screen notification
		sendNotification(player, "Congratulations! 50 coins collected")
	end
end

-- Continuous milestone checker running asynchronously
coroutine.wrap(function()
	while true do
		wait(10)  -- Interval between checks, balance performance and responsiveness
		for _, player in ipairs(Players:GetPlayers()) do
			checkForMilestones(player)  -- Evaluate milestone conditions for each player
		end
	end
end)()

